# ===========================================
# Weddingly Builder - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
# Your PostgreSQL database connection URL
# Local: postgresql://username:password@localhost:5432/weddingly
# Coolify/VPS: postgresql://username:password@internal-postgres-host:5432/wedding
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/weddingly"

# ===========================================
# Session Configuration
# ===========================================
# A random secret key for session encryption (generate a random string)
SESSION_SECRET="your-random-secret-key-here-change-in-production"

# ===========================================
# MinIO Configuration (S3-Compatible Storage)
# ===========================================
# MinIO is a high-performance, S3-compatible object storage
# Self-host it on your VPS via Coolify or Docker

# MinIO endpoint used by the server-side upload API
# Local Docker: http://localhost:9000
# Same Compose stack: http://minio:9000 inside Docker; public URL is https://media.your-domain.com
MINIO_ENDPOINT="http://localhost:9000"

# MinIO credentials (created during MinIO setup)
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"

# Bucket name for storing wedding media
MINIO_BUCKET="weddingly"

# Public MinIO URL (accessible from the browser for direct audio access)
PUBLIC_MINIO_URL="http://localhost:9000"

# ===========================================
# imgproxy Configuration (Image Processing)
# ===========================================
# imgproxy is a fast, secure image processing server
# The repository root docker-compose.yml deploys Weddingly, imgproxy, and MinIO together

# Public imgproxy URL (used for generating image URLs)
# Local Docker: http://localhost:8080
# Coolify/VPS: https://images.your-domain.com
PUBLIC_IMGPROXY_URL="http://localhost:8080"

# Optional: imgproxy URL signing (leave empty until the app generates signed URLs)
# Generate with: echo $(xxd -g 2 -l 64 -p /dev/random | tr -d '\n')
# These must match the values configured in imgproxy after signing support is enabled
# IMGPROXY_KEY="your-hex-encoded-key"
# IMGPROXY_SALT="your-hex-encoded-salt"

# ===========================================
# Docker Compose / Coolify Media Stack
# ===========================================
# Used by docker-compose.yml when deploying the MinIO + imgproxy stack.
# Keep these equal to MINIO_ACCESS_KEY and MINIO_SECRET_KEY above.
MINIO_SERVER_URL=""
MINIO_BROWSER_REDIRECT_URL=""
AWS_REGION="us-east-1"
IMGPROXY_CONCURRENCY="10"
IMGPROXY_MAX_SRC_RESOLUTION="50"
IMGPROXY_MAX_SRC_FILE_SIZE="10485760"
IMGPROXY_PREFERRED_FORMATS="webp,avif,jpeg"

# ===========================================
# Optional: Application Settings
# ===========================================
# Set to 'production' when deploying
NODE_ENV="development"

# ===========================================
# Optional: Seed Accounts (local/development)
# ===========================================
# The seed creates the super admin and demo user. Override these before running
# `npx prisma db seed`; never commit real production passwords.
SUPER_ADMIN_EMAIL="admin@owner.me"
SUPER_ADMIN_PASSWORD="change-this-local-password"
# SEED_USER_EMAIL="demo@weddingly.local"
# SEED_USER_PASSWORD="change-this-demo-password"

# The base URL of your application (for generating links)
# PUBLIC_APP_URL="http://localhost:4321"
