// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SUPER_ADMIN
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  weddingSite WeddingSite?
}

model WeddingTemplate {
  id          String   @id
  name        String
  description String
  rendererId  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model WeddingSite {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // URL and Publishing
  slug      String   @unique
  isPublished Boolean @default(false)
  password  String?
  templateId String  @default("classic")
  
  // Global Styles
  primaryColor   String @default("#e4b6c6")
  secondaryColor String @default("#d4a5a5")
  accentColor    String @default("#9b7e7e")
  headingFont    String @default("Playfair Display")
  bodyFont       String @default("Lato")
  
  // Hero Section
  heroEnabled      Boolean  @default(true)
  brideName        String?
  groomName        String?
  weddingDate      DateTime?
  heroImageUrl     String?

  // Optional Couple Details Section
  coupleDetailsEnabled Boolean @default(false)
  brideFullName        String?
  brideParents         String?
  bridePhotoUrl        String?
  groomFullName        String?
  groomParents         String?
  groomPhotoUrl        String?

  // Optional Quote Section
  quoteEnabled Boolean @default(false)
  quoteText    String?
  quoteSource  String?
  
  // Our Story Section
  storyEnabled     Boolean @default(true)
  storyTitle       String  @default("Our Story")
  storyText        String?
  storyImage1Url   String?
  storyImage2Url   String?

  // Optional Story Timeline Section
  storyTimelineEnabled Boolean @default(false)
  storyTimeline        Json    @default("[]")

  // Optional Dress Code Section
  dressCodeEnabled Boolean  @default(false)
  dressCodeTitle   String   @default("Dress Code")
  dressCodeText    String?
  dressCodeColors  String[] @default([])
  
  // Photo Gallery Section
  galleryEnabled   Boolean @default(false)
  galleryTitle     String  @default("Our Gallery")
  galleryImages    String[] // Array of image URLs (max 10)
  
  // Gift Registry Section
  registryEnabled  Boolean @default(true)
  registryTitle    String  @default("Gift Registry")
  registryText     String?
  bankAccounts     Json    @default("[]")
  giftAddress      String?
  
  // Music Section
  musicEnabled     Boolean @default(true)
  musicUrl         String?
  musicTitle       String?
  musicArtist      String?

  // Optional Live Streaming Section
  liveStreamEnabled Boolean @default(false)
  liveStreamUrl     String?

  // RSVP and Wishes
  rsvpEnabled           Boolean @default(true)
  rsvpGuestCountEnabled Boolean @default(false)
  wishesEnabled         Boolean @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  events Event[]
  rsvps  RSVP[]
  wishes WeddingWish[]
}

model Event {
  id        String   @id @default(cuid())
  siteId    String
  site      WeddingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  title     String
  date      DateTime
  time      String
  location  String
  address   String
  order     Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([siteId])
}

model RSVP {
  id        String   @id @default(cuid())
  siteId    String
  site      WeddingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  
  fullName  String
  email     String?
  attending Boolean
  guestCount Int?
  dietaryRestrictions String?
  message   String?
  
  createdAt DateTime @default(now())
  
  @@index([siteId])
}

model WeddingWish {
  id        String      @id @default(cuid())
  siteId    String
  site      WeddingSite @relation(fields: [siteId], references: [id], onDelete: Cascade)

  fullName   String
  message    String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([siteId])
}
