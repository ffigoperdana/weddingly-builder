# Use this with docker-compose.local.yml and docker-compose.db.local.yml.
# The containerized app overrides DATABASE_URL to use postgres:5432 internally.
# This host URL remains useful for Prisma CLI commands run on the laptop.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/weddingly"

POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="weddingly"
POSTGRES_PORT="5433"
